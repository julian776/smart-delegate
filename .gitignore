# Local tool state and install artifacts — not part of the project.
# Regenerated or reinstalled as needed; never committed.

# Local copy of the installed skills (skills CLI writes here)
/.agents/

# Skills CLI project install artifact
/skills-lock.json

# Python bytecode
__pycache__/
*.py[cod]

# NOTE: CLAUDE.md and .rtk/ are deliberately NOT ignored.
# CLAUDE.md holds repository guidance, and .rtk/filters.toml holds project-local
# RTK filters, which RTK's own documentation says to commit with the repo.
